# First launch: add existing keys in the manager's Models and Roles screen.
# Optional server override: false disables model calls; blank uses role choices.
ASSISTANT_AI_ENABLED=
# Optional administrator-owned connections file (UI connections do not need it).
ASSISTANT_LLM_CONFIG=
ASSISTANT_LLM_KEY_OPENAI=
ASSISTANT_LLM_KEY_VSEGPT=
ASSISTANT_LLM_KEY_CLAUDE=
ASSISTANT_LLM_KEY_GIGACHAT=
ASSISTANT_LLM_KEY_OPENROUTER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ASSISTANT_ADMIN_TOKEN=
ASSISTANT_SERVER_ORIGIN=
ASSISTANT_DELIVERY_ENABLED=false
ASSISTANT_DATA_DIR=.data
ASSISTANT_HOST=127.0.0.1
ASSISTANT_PORT=8787
